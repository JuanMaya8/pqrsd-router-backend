PORT=3001
# development | production. In production STAFF_API_KEY is mandatory (the server refuses to boot without it).
NODE_ENV=development
# Key for staff routes (header X-Staff-Key) and the staff socket room. Empty = open (development only).
STAFF_API_KEY=
# pqrsd-router-ai
AI_URL=http://localhost:8000
AI_API_KEY=
# Classification timeout: after it the fallback keyword classifier is used (and the AI is skipped for 20 s)
AI_TIMEOUT_MS=8000
# Where cases are stored (one JSON file per case). Mount a volume here in production.
DATA_DIR=./data
# Comma-separated list of allowed browser origins (the frontend)
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT_MB=5
# Requests per minute per IP (all routes) and for the two anonymous write routes (preview, create)
THROTTLE_LIMIT=300
PUBLIC_WRITE_LIMIT=20
# Reverse-proxy hops to trust for the client IP (set 1 behind nginx/Render/Fly so rate limiting sees the real IP)
TRUST_PROXY=0
# Business days for denuncias (depends on the applicable procedure: validate with your legal area)
DENUNCIA_DAYS=15
# 0 = every case waits for human triage. 0.85 = confident, unflagged AI results skip triage (enable only after measuring with real data)
AUTO_ASSIGN_MIN_CONFIDENCE=0
# Also send «confirm» actions to the AI as training feedback (default false: avoids confirmation bias)
FEEDBACK_ON_CONFIRM=false
